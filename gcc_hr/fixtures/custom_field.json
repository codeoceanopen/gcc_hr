  "label": "Housing Allowance",
  "insert_after": "gcc_basic_salary"
 },
 {
  "doctype": "Custom Field",
  "name": "Contract-gcc_hr_salary_column_break",
  "dt": "Contract",
  "fieldname": "gcc_hr_salary_column_break",
